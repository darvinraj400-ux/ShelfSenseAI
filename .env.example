# Flask Configuration
# Generate a secure key using: python -c 'import secrets; print(secrets.token_hex(16))'
SECRET_KEY=your_secure_secret_key_here

# Database Configuration
# Format: mysql+pymysql://<username>:<password>@<host>/<database_name>
DATABASE_URL=mysql+pymysql://root:password@localhost/shelfsenseai

# AI & Market Intelligence
# Required for Phase 3 features (LLM Explainer)
GEMINI_API_KEY=your_google_gemini_api_key_here
